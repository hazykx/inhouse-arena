# ─── Základ ─────────────────────────────────────────────
# Adresa webu (lokálně http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
# Náhodný tajný klíč – vygeneruj: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Databáze – lokálně stačí soubor. Na produkci např. Turso (libsql://...)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# ─── Discord (přihlášení) ───────────────────────────────
# https://discord.com/developers/applications → OAuth2
# Redirect: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── Twitch (propojení účtu + live stav) ────────────────
# https://dev.twitch.tv/console/apps
# Redirect: http://localhost:3000/api/auth/callback/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── Kick (propojení účtu + live stav) ──────────────────
# https://kick.com/settings/developer
# Redirect: http://localhost:3000/api/auth/callback/kick
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ─── Riot Games API ─────────────────────────────────────
# https://developer.riotgames.com (vývojový klíč platí 24 h)
RIOT_API_KEY=

# ─── Admini ─────────────────────────────────────────────
# Discord ID adminů oddělená čárkou (mohou mazat cizí inzeráty a turnaje
# a nastavit doporučený turnaj). ID zjistíš: Discord → Nastavení → Pokročilé →
# Režim vývojáře, pak pravý klik na své jméno → Kopírovat ID uživatele.
ADMIN_DISCORD_IDS=
